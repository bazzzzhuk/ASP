@* @rendermode InteractiveServer *@
<h6>Leerning days:</h6>

<ul class="weekdays form-control">
	@for (int i = 0; i < 7; i++)
	{
		<li>
			<input type="checkbox" id="@Week.DAYNAMES[i]" @bind="@days[i]" @bind:after="Week_to_int"@*  @onchange="StHasCh[i]" *@ />
			<label for="@Week.DAYNAMES[i]">@Week.DAYNAMES[i]</label>
		</li>
		<li>
			@* <label for="WeekDays">Weekdays:</label>
			<></> *@
		</li>
	}
</ul>

@code
{
	bool[] days = new bool[7];
	[Parameter] public Models.Group Group { get; set; }

	[Parameter] public EventCallback OnWeekdaysChanged { get; set; }

	int week_int;
	void Unzip_to_week()
	{
		for (int i = 0; i < 7; i++)
		{
			if ((Group.weekdays >> i & 1) != 0) days[i] = true;
		}
		// StateHasChanged();
	}
	void Week_to_int()
	{
		week_int = 0;
		for (int i = 0; i < 7; i++)
		{
			if (days[i]!=true) week_int |= 1 << i;
		}
		Group.weekdays = week_int;
		// StateHasChanged();
	}
	void StHasCh(ChangeEventArgs e)
	{
		
		StateHasChanged();
	}
	protected override void OnInitialized()
	{
		Unzip_to_week();
	}

}
